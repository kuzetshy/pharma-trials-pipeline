# ==============================================================================
# Clinical Trials ELT & GenAI Pipeline Configuration Template
# ==============================================================================

# API Configuration
API_BASE_URL=https://clinicaltrials.gov/api/v2/studies
SEARCH_CONDITION=Breast Cancer
PAGE_SIZE=100
MAX_BATCHES=3

# HTTP Client & Ingestion Reliability
REQUEST_TIMEOUT_SECONDS=30.0
MAX_RETRIES=4
BACKOFF_FACTOR=2.0
RATE_LIMIT_DELAY=0.5

# Paths
DATA_DIR=./data
BRONZE_DIR=./data/bronze
SILVER_DIR=./data/silver
GOLD_DIR=./data/gold

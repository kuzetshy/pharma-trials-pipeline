# ==============================================================================
# Docker Build Context Ignore List
# ==============================================================================

# Git & GitHub
.git/
.gitignore
.github/

# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
wheels/

# Testing & developer tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
tests/
requirements-dev.txt

# Secrets & credentials (NEVER bake into image)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
*service_account*.json
*client_secret*.json
credentials.json
token.json
*.kdbx

# Handover notes & exploratory notebooks
HANDOVER.md
*handover*.md
notebooks/

# OS & Editor files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~
